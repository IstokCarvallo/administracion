 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dbo.matriz_tiempos~" )  TABLE(NAME=~"dbo.comunasexp~" ALIAS=~"comunasexp_a~" )  TABLE(NAME=~"dbo.comunasexp~" ALIAS=~"comunasexp_b~" ) COLUMN(NAME=~"dbo.matriz_tiempos.comuna_origen_id~") COLUMN(NAME=~"dbo.matriz_tiempos.comuna_destino_id~") COLUMN(NAME=~"dbo.matriz_tiempos.tiempo_horas~") COLUMN(NAME=~"dbo.matriz_tiempos.usuario_modificacion~") COLUMN(NAME=~"dbo.matriz_tiempos.fecha_modificacion~") COLUMN(NAME=~"comunasexp_a.comu_nombre~") COLUMN(NAME=~"comunasexp_b.comu_nombre~")    JOIN (LEFT=~"dbo.matriz_tiempos.comuna_origen_id~"    OP =~"=~"RIGHT=~"comunasexp_a.comuna_id~" )    JOIN (LEFT=~"dbo.matriz_tiempos.comuna_destino_id~"    OP =~"=~"RIGHT=~"comunasexp_b.comuna_id~" )WHERE(    EXP1 =~":Comuna~"   OP =~"in~"    EXP2 =~"(-1, dbo.matriz_tiempos.comuna_origen_id)~" ) ) ARG(NAME = ~"Comuna~" TYPE = number) " arguments=(("Comuna", number))  sort="tiempo_horas D comuna_destino_id A " )
