table(column=(type=long update=yes updatewhereclause=yes name=comuna_origen_id dbname="matriz_tiempos.comuna_origen_id" dbalias=".comuna_origen_id" )
 column=(type=long update=yes updatewhereclause=yes name=comuna_destino_id dbname="matriz_tiempos.comuna_destino_id" dbalias=".comuna_destino_id" )
