 column=(type=decimal(0) update=yes updatewhereclause=yes name=caar_codigo dbname="Casino_PersonaColacion.caar_codigo" )
 column=(type=char(40) updatewhereclause=yes name=caar_nombre dbname="Casino_Areas.caar_nombre" )
 retrieve="Select pc.cape_codigo, pc.cape_apepat, pc.cape_apemat, pc.cape_nombre, pc.caar_codigo, ca.caar_nombre
    From dbo.casino_personacolacion pc Inner Join dbo.remupersonal rp
							On pc.cape_codigo = rp.pers_codigo
							And rp.pers_estado = 2
										Inner Join dbo.Casino_Areas ca
							On pc.caar_codigo = ca.caar_codigo" update="dbo.casino_personacolacion" updatewhere=0 updatekeyinplace=yes  sort="cape_codigo A cape_apepat A cape_apemat A cape_nombre A caar_nombre A " )
