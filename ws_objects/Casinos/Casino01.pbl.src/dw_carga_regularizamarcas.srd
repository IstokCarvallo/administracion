 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dbo.Casino_MovtoColaciones~" )  TABLE(NAME=~"dbo.empresas~" )  TABLE(NAME=~"dbo.centrocosto~" )  TABLE(NAME=~"dbo.Casino_Areas~" )  TABLE(NAME=~"dbo.REMUPERSONAL~" ) COLUMN(NAME=~"dbo.Casino_MovtoColaciones.zona_codigo~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.caar_codigo~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.cape_codigo~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.camv_estado~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.camv_fecham~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.usua_codigo~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.ccos_codigo~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.camv_appain~") COLUMN(NAME=~"dbo.empresas.empr_nombre~") COLUMN(NAME=~"dbo.centrocosto.ccos_nombre~") COLUMN(NAME=~"dbo.Casino_Areas.caar_nombre~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_APEPAT~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_APEMAT~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_NOMBRE~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.camv_fechac~") COLUMN(NAME=~"dbo.Casino_MovtoColaciones.camv_secuen~")    JOIN (LEFT=~"dbo.Casino_MovtoColaciones.clpr_rut~"    OP =~"=~"RIGHT=~"dbo.empresas.empr_codigo~" )    JOIN (LEFT=~"dbo.Casino_MovtoColaciones.clpr_rut~"    OP =~"=~"RIGHT=~"dbo.centrocosto.ccos_rutcco~" )    JOIN (LEFT=~"dbo.Casino_MovtoColaciones.ccos_codigo~"    OP =~"=~"RIGHT=~"dbo.centrocosto.ccos_codigo~" )    JOIN (LEFT=~"dbo.Casino_MovtoColaciones.zona_codigo~"    OP =~"=~"RIGHT=~"dbo.Casino_Areas.zona_codigo~" )    JOIN (LEFT=~"dbo.Casino_MovtoColaciones.caar_codigo~"    OP =~"=~"RIGHT=~"dbo.Casino_Areas.caar_codigo~" )    JOIN (LEFT=~"dbo.Casino_MovtoColaciones.clpr_rut~"    OP =~"=~"RIGHT=~"dbo.Casino_Areas.empr_codigo~" )    JOIN (LEFT=~"dbo.Casino_MovtoColaciones.cape_codigo~"    OP =~"=~"RIGHT=~"dbo.REMUPERSONAL.PERS_CODIGO~" )WHERE(    EXP1 =~"dbo.Casino_MovtoColaciones.camv_estado~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~":Zona~"   OP =~"in~"    EXP2 =~"(-1, dbo.Casino_MovtoColaciones.zona_codigo)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~":Tipo~"   OP =~"in~"    EXP2 =~"(-1, dbo.Casino_MovtoColaciones.tico_codigo)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"Datediff(dd, :Fecha, dbo.Casino_MovtoColaciones.camv_fechac)~"   OP =~"=~"    EXP2 =~"0~" ) ) ORDER(NAME=~"dbo.Casino_MovtoColaciones.clpr_rut~" ASC=yes )  ORDER(NAME=~"dbo.Casino_MovtoColaciones.caar_codigo~" ASC=yes )  ORDER(NAME=~"dbo.Casino_MovtoColaciones.ccos_codigo~" ASC=yes ) ARG(NAME = ~"Zona~" TYPE = number)  ARG(NAME = ~"Tipo~" TYPE = number)  ARG(NAME = ~"Fecha~" TYPE = date) " update="dbo.Casino_MovtoColaciones" updatewhere=0 updatekeyinplace=yes arguments=(("Zona", number),("Tipo", number),("Fecha", date)) )
