table(column=(type=char(10) updatewhereclause=yes key=yes name=pers_codigo dbname="pers_codigo" )
 column=(type=char(25) updatewhereclause=yes name=pers_apepat dbname="pers_apepat" )
 column=(type=char(25) updatewhereclause=yes name=pers_apemat dbname="pers_apemat" )
 column=(type=char(25) updatewhereclause=yes name=pers_nombre dbname="pers_nombre" )
 column=(type=char(40) updatewhereclause=yes name=caar_nombre dbname="caar_nombre" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=turn_codigo dbname="turn_codigo" )
 retrieve="  Select rp.pers_codigo, rp.pers_apepat, 
		 rp.pers_apemat, rp.pers_nombre, 
		 ar.caar_nombre,  turn_codigo = IsNull(rp.turn_codigo, 1)
    From dbo.remupersonal rp Inner Join [dbo].[Casino_PersonaColacion] pc
					On rp.pers_codigo = pc.cape_codigo
								Inner Join [dbo].[Casino_Areas] ar
					On pc.zona_codigo = ar.zona_codigo
					And pc.empr_codigo = ar.empr_codigo
					And pc.caar_codigo = ar.caar_codigo
   Where rp.pers_estado <> 2" update="dbo.remupersonal" updatewhere=0 updatekeyinplace=yes )
