 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dbo.REMUPERSONAL~" ) COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_RUTEMP~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_APEPAT~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_APEMAT~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_NOMBRE~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_NROTAR~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_SEXO~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_ESTCIV~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_NACION~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_DIRECC~") COLUMN(NAME=~"dbo.REMUPERSONAL.CIUD_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.COMU_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_NROFON~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_ESTADO~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_PENSIO~") COLUMN(NAME=~"dbo.REMUPERSONAL.AFPS_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.ISAP_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_PLANSA~") COLUMN(NAME=~"dbo.REMUPERSONAL.PERS_LEY2AD~") COLUMN(NAME=~"dbo.REMUPERSONAL.SUCU_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.CONT_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.pers_sermed~") COLUMN(NAME=~"dbo.REMUPERSONAL.SUPA_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.SMCE_CODIGO~") COLUMN(NAME=~"dbo.REMUPERSONAL.empr_codigo~") COLUMN(NAME=~"dbo.REMUPERSONAL.turn_codigo~")WHERE(    EXP1 =~"dbo.REMUPERSONAL.empr_codigo~"   OP =~"=~"    EXP2 =~":Empresa~" ) ) ARG(NAME = ~"Empresa~" TYPE = number) " update="dbo.REMUPERSONAL" updatewhere=0 updatekeyinplace=yes arguments=(("Empresa", number)) )
